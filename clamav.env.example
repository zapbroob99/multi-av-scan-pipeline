# Optional ClamAV signature-update settings. Copy to clamav.env next to the
# compose file only when the default (freshclam contacting database.clamav.net
# directly) does not fit. The file is read by the clamav container alone.
# Any freshclam.conf or clamd.conf directive can be set with the
# FRESHCLAM_CONF_ or CLAMD_CONF_ prefix. Keep only the lines you need.

# A: an institution-run mirror that serves main/daily/bytecode over HTTP(S).
# FRESHCLAM_CONF_PrivateMirror=http://clamav-mirror.example.internal

# B: the official service through the institution's HTTP proxy.
# FRESHCLAM_CONF_HTTPProxyServer=proxy.example.internal
# FRESHCLAM_CONF_HTTPProxyPort=8080

# C: no update path at all. freshclam stays off and signatures are loaded
#    with deploy/pilot/load_clamav_signatures.sh (run it before the first
#    start: clamd does not start without a database).
# CLAMAV_NO_FRESHCLAMD=true

# How many times a day freshclam checks (A and B). The image default is 1.
# FRESHCLAM_CHECKS=12
