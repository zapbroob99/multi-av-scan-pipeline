# MASP production environment — TEMPLATE.
#
# Copy to `.env.production` and fill in real values. `.env.production` is
# gitignored; NEVER commit real credentials. Used by:
#   docker compose -f docker-compose.prod.yml --env-file .env.production ...
#
# All placeholder values below are examples, not real secrets.

# --- Database (external, operator-managed) -----------------------------------
# Full PostgreSQL DSN. MASP does NOT run its own database in production.
# Require encrypted transport unless the database team supplies a stronger
# verify-full DSN and mounts the corporate CA into the containers.
MASP_DATABASE_URL=postgresql://USER:PASSWORD@db-host.internal:5432/masp?sslmode=require

# Pool size is per MASP process. With app + worker + ICAP and max=4, MASP can
# consume up to 12 PostgreSQL connections. Leave headroom for administration.
MASP_DB_POOL_ENABLED=1
MASP_DB_POOL_MIN=0
MASP_DB_POOL_MAX=4
MASP_DB_POOL_TIMEOUT_SECONDS=30

# --- REST API ----------------------------------------------------------------
# Mandatory. Without it the API returns 503 for every authenticated call.
# Comma-separated list is allowed (MASP_API_TOKENS also supported).
# Generate a strong random token, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
MASP_API_TOKEN=CHANGE_ME_STRONG_RANDOM_TOKEN
MASP_SECRET_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# Synchronous wait cap and client poll hint.
MASP_API_MAX_WAIT_SECONDS=30
MASP_API_RETRY_AFTER_SECONDS=2

# Upload size limit in bytes. 52428800 = 50 MiB (integration contract v1 value).
MASP_UPLOAD_MAX_BYTES=52428800

# --- LDAP / Active Directory login (optional) -------------------------------
# MASP uses a TLS-protected service-account search followed by a bind as the
# user. LDAP passwords are never stored. Direct memberOf values map to roles.
MASP_LDAP_ENABLED=0
MASP_LDAP_HOST=
MASP_LDAP_PORT=636
MASP_LDAP_TLS_MODE=ldaps
MASP_LDAP_CA_CERT_FILE=
MASP_LDAP_CONNECT_TIMEOUT=5
MASP_LDAP_RECEIVE_TIMEOUT=8
MASP_LDAP_BIND_DN=
MASP_LDAP_BIND_PASSWORD=
MASP_LDAP_BASE_DN=
MASP_LDAP_USER_FILTER=(sAMAccountName={username})
MASP_LDAP_USERNAME_ATTRIBUTE=sAMAccountName
MASP_LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
MASP_LDAP_GROUP_ATTRIBUTE=memberOf
MASP_LDAP_ADMIN_GROUP_DN=
MASP_LDAP_ANALYST_GROUP_DN=

# --- VirusTotal hash reputation (optional) ----------------------------------
# This is for SHA-256 report retrieval only: MASP never uploads the file and
# never requests a re-analysis. Use a licensed Premium/Enterprise API key; the
# VirusTotal Public API terms prohibit automated commercial/business workflows
# that do not contribute new files. Keep disabled until licensing and outbound
# HTTPS to www.virustotal.com are approved.
MASP_VIRUSTOTAL_ENABLED=0
MASP_VIRUSTOTAL_API_KEY=
MASP_VIRUSTOTAL_TIMEOUT_SECONDS=10
MASP_VIRUSTOTAL_CACHE_SECONDS=3600
MASP_VIRUSTOTAL_UNKNOWN_CACHE_SECONDS=300
MASP_VIRUSTOTAL_CACHE_MAX_ENTRIES=10000
MASP_VIRUSTOTAL_MALICIOUS_THRESHOLD=1
# Conservative default: zero detections still means review. Set to 1 only when
# the data owner explicitly accepts VirusTotal-undetected as an allow signal.
MASP_VIRUSTOTAL_ALLOW_UNDETECTED=0
MASP_VIRUSTOTAL_MAX_AGE_DAYS=30

# Where the API listens on the host. Keep it behind a TLS-terminating HTTP
# reverse proxy; 127.0.0.1 means only a proxy on this host can reach it. For a
# remote LB, bind a private interface and firewall it to the LB source only.
MASP_APP_BIND=127.0.0.1:8000

# --- ICAP (only used with `--profile icap`) ----------------------------------
# ICAP is plain RFC 3507 TCP, not HTTP and not TLS-enabled by MASP. For a remote
# storage ICAP client, bind a private host interface (for example 10.0.10.20:1344) and
# restrict TCP/1344 with the network firewall plus MASP_ICAP_ALLOWED_IPS.
MASP_ICAP_BIND=127.0.0.1:1344
MASP_ICAP_SERVICE_NAME=masp
MASP_ICAP_WAIT_SECONDS=30
MASP_ICAP_MAX_BYTES=52428800
# Security posture (leave at 1 for production):
#   FAIL_MODE_CLOSED=1  -> block on timeout / oversize / error
#   BLOCK_ON_REVIEW=1   -> block "review" verdicts, not just "block"
MASP_ICAP_FAIL_MODE_CLOSED=1
MASP_ICAP_BLOCK_ON_REVIEW=1
# Optional comma-separated client IP allowlist. Set it whenever ICAP is exposed
# beyond localhost; an empty value allows every client that can reach the port.
MASP_ICAP_ALLOWED_IPS=

# --- Worker ------------------------------------------------------------------
MASP_WORKER_POLL_SECONDS=2
MASP_WORKER_ENGINE_KEYS=static_metadata,clamav,yara,virustotal
MASP_WORKER_NODE_ID=production-linux-worker-01
MASP_WORKER_NODE_NAME=Production Linux Worker 01
MASP_WORKER_AGENT_VERSION=0.1.0
MASP_WORKER_LABELS=site=primary,os=linux
MASP_WORKER_CAPACITY=1
MASP_WORKER_HEALTH_INTERVAL_SECONDS=60
MASP_WORKER_HEALTH_LEASE_SECONDS=1200
MASP_WORKER_HEALTH_CHECKS_PER_TICK=2
MASP_WORKER_ENROLLMENT_TOKEN=CHANGE_ME_LONG_RANDOM_WORKER_ENROLLMENT_TOKEN
MASP_WORKER_AGENT_TOKEN_TTL_DAYS=90
MASP_WORKER_CONTROL_REQUIRE_HTTPS=1
MASP_WORKER_TRANSPORT=database
MASP_WORKER_CONTROL_URL=
MASP_WORKER_AGENT_TOKEN_FILE=
MASP_WORKER_CONTROL_CA_FILE=
MASP_WORKER_CONTROL_ALLOW_INSECURE_HTTP=0

# --- Host paths (bind mounts) ------------------------------------------------
# Persisted sample storage and YARA rules. Use absolute paths in production.
MASP_STORAGE_DIR=./storage
MASP_RULES_DIR=./rules

# --- ClamAV scan limits (optional overrides) ---------------------------------
# clamd's own size caps. These bind BEFORE the ClamAV adapter's
# max_file_size_bytes: a sample larger than the smallest of them is skipped with
# an explicit reason instead of being streamed to clamd and rejected there. The
# compose files pass these to the app and worker as well as to clamd, so raising
# a limit means raising it HERE, not only in the engine config form.
MASP_CLAMD_STREAM_MAX_LENGTH=64M
MASP_CLAMD_MAX_FILE_SIZE=64M
MASP_CLAMD_MAX_SCAN_SIZE=64M

# --- Monitoring --------------------------------------------------------------
# GET /metrics serves Prometheus text-format metrics and requires the API bearer
# token (the payload reports scan volumes and detection counts). /health stays
# unauthenticated for the load balancer. Set to 0 to remove the endpoint.
# Alert conditions are listed in docs/deployment/PRODUCTION.md.
MASP_METRICS_ENABLED=1

# --- Data retention ----------------------------------------------------------
# 0 keeps every sample and scan record forever. Samples are real malware and may
# contain confidential uploads, so agree a window with the data owner.
MASP_RETENTION_DAYS=0
MASP_RETENTION_BATCH_SIZE=100
