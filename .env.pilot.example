# MASP single-host pilot environment template.
# Copy to .env.pilot, replace every CHANGE_ME value, then chmod 600.

# Release images. Keep these fixed for a deployed pilot release.
MASP_IMAGE=masp-pilot:0.1.0-pilot.4
MASP_POSTGRES_IMAGE=postgres:16-alpine@sha256:e013e867e712fec275706a6c51c966f0bb0c93cfa8f51000f85a15f9865a28cb
MASP_CLAMAV_IMAGE=clamav/clamav:stable@sha256:1b6443c4a7b456baa1abfaf9796815f8d21e2fb558dbaed5b682fd4552d8b0c3

# Use URL-safe values because this password is embedded in the internal DSN.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MASP_POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_DATABASE_PASSWORD
MASP_API_TOKEN=CHANGE_ME_STRONG_API_TOKEN
MASP_SECRET_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# Bootstrap admin account. Seeded on first start only; there is NO default
# password. Changing this later does NOT reset an existing admin — rotate the
# password from the admin UI. Login hints stay off in the pilot.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
MASP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Bind API to loopback when a reverse proxy runs on this host. For a remote
# load balancer, bind the MASP private IP and firewall it to the LB sources.
MASP_APP_BIND=127.0.0.1:8000

# --- LDAP / Active Directory login (optional) -------------------------------
# MASP uses a TLS-protected service-account search followed by a bind as the
# user. LDAP passwords are never stored. Direct memberOf values map to roles.
MASP_LDAP_ENABLED=0
MASP_LDAP_HOST=
MASP_LDAP_PORT=636
MASP_LDAP_TLS_MODE=ldaps
MASP_LDAP_CA_CERT_FILE=
MASP_LDAP_CONNECT_TIMEOUT=5
MASP_LDAP_RECEIVE_TIMEOUT=8
MASP_LDAP_BIND_DN=
MASP_LDAP_BIND_PASSWORD=
MASP_LDAP_BASE_DN=
MASP_LDAP_USER_FILTER=(sAMAccountName={username})
MASP_LDAP_USERNAME_ATTRIBUTE=sAMAccountName
MASP_LDAP_DISPLAY_NAME_ATTRIBUTE=displayName
MASP_LDAP_GROUP_ATTRIBUTE=memberOf
MASP_LDAP_ADMIN_GROUP_DN=
MASP_LDAP_ANALYST_GROUP_DN=

# ICAP is plain RFC 3507 TCP. Bind a private MASP interface for the storage client; never
# expose it to an untrusted network.
MASP_ICAP_BIND=127.0.0.1:1344
MASP_ICAP_SERVICE_NAME=masp
MASP_ICAP_ALLOWED_IPS=127.0.0.1
MASP_ICAP_WAIT_SECONDS=30
MASP_ICAP_PREVIEW_BYTES=0

# 50 MiB synchronous pilot limit. ICAP buffers complete request bodies, so do
# not remove this limit without a separate large-file design and benchmark.
MASP_UPLOAD_MAX_BYTES=52428800
MASP_ICAP_MAX_BYTES=52428800

# Persist samples on the host so the directory can later be shared with remote
# Defender/ESET workers. Use absolute Linux paths in the deployed environment.
MASP_STORAGE_DIR=/srv/masp/storage
MASP_RULES_DIR=./rules

MASP_API_MAX_WAIT_SECONDS=30
MASP_API_RETRY_AFTER_SECONDS=2

# Optional SHA-256-only VirusTotal reputation lookup for files that are too
# large to upload to MASP. Requires a licensed API plan valid for an automated
# organizational workflow; the Public API terms do not permit this use case.
# Only the hash is sent. Unknown and undetected default to review, not allow.
MASP_VIRUSTOTAL_ENABLED=0
MASP_VIRUSTOTAL_API_KEY=
MASP_VIRUSTOTAL_TIMEOUT_SECONDS=10
MASP_VIRUSTOTAL_CACHE_SECONDS=3600
MASP_VIRUSTOTAL_UNKNOWN_CACHE_SECONDS=300
MASP_VIRUSTOTAL_CACHE_MAX_ENTRIES=10000
MASP_VIRUSTOTAL_MALICIOUS_THRESHOLD=1
MASP_VIRUSTOTAL_ALLOW_UNDETECTED=0
MASP_VIRUSTOTAL_MAX_AGE_DAYS=30

MASP_SCAN_PARTIAL_RESULTS_MAX_WAIT_SECONDS=120
MASP_WORKER_POLL_SECONDS=2
MASP_WORKER_TIMING_EVENTS_ENABLED=1
MASP_WORKER_ENGINE_KEYS=static_metadata,clamav,yara,virustotal
MASP_WORKER_NODE_ID=pilot-linux-worker
MASP_WORKER_NODE_NAME=Pilot Linux Worker
MASP_WORKER_AGENT_VERSION=0.1.0
MASP_WORKER_LABELS=site=pilot,os=linux
MASP_WORKER_CAPACITY=1
MASP_WORKER_HEALTH_INTERVAL_SECONDS=60
MASP_WORKER_HEALTH_LEASE_SECONDS=1200
MASP_WORKER_HEALTH_CHECKS_PER_TICK=2
MASP_WORKER_ENROLLMENT_TOKEN=CHANGE_ME_LONG_RANDOM_WORKER_ENROLLMENT_TOKEN
MASP_WORKER_AGENT_TOKEN_TTL_DAYS=90
MASP_WORKER_CONTROL_REQUIRE_HTTPS=1
MASP_WORKER_TRANSPORT=database
MASP_WORKER_CONTROL_URL=
MASP_WORKER_AGENT_TOKEN_FILE=
MASP_WORKER_CONTROL_CA_FILE=
MASP_WORKER_CONTROL_ALLOW_INSECURE_HTTP=0
MASP_ENGINE_JOB_LEASE_SECONDS=120

# Pool max is per process: app + worker + ICAP = at most 12 connections here.
MASP_DB_POOL_ENABLED=1
MASP_DB_POOL_MIN=0
MASP_DB_POOL_MAX=4
MASP_DB_POOL_TIMEOUT_SECONDS=30

MASP_CLAMD_TIMEOUT_SECONDS=180
MASP_CLAMD_READY_TIMEOUT_SECONDS=30
# clamd's own size caps. These bind BEFORE the ClamAV adapter's
# max_file_size_bytes: a sample larger than the smallest of them is skipped with
# an explicit reason instead of being streamed to clamd and rejected there. The
# compose files pass these to the app and worker as well as to clamd, so raising
# a limit means raising it HERE, not only in the engine config form.
MASP_CLAMD_STREAM_MAX_LENGTH=64M
MASP_CLAMD_MAX_FILE_SIZE=64M
MASP_CLAMD_MAX_SCAN_SIZE=64M

MASP_LOG_MAX_SIZE=20m
MASP_LOG_MAX_FILES=5

# GET /metrics (Prometheus format) requires the API bearer token; /health does
# not. Set to 0 if the pilot has no scraper. See docs/deployment/PILOT.md.
MASP_METRICS_ENABLED=1

# 0 keeps every sample forever; agree a retention window with the data owner.
MASP_RETENTION_DAYS=0
