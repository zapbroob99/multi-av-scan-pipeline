# MASP single-host pilot environment template.
# Copy to .env.pilot, replace every CHANGE_ME value, then chmod 600.

# Release images. Keep these fixed for a deployed pilot release.
MASP_IMAGE=masp-pilot:0.1.0-pilot.2
MASP_POSTGRES_IMAGE=postgres:16-alpine@sha256:e013e867e712fec275706a6c51c966f0bb0c93cfa8f51000f85a15f9865a28cb
MASP_CLAMAV_IMAGE=clamav/clamav:stable@sha256:1b6443c4a7b456baa1abfaf9796815f8d21e2fb558dbaed5b682fd4552d8b0c3

# Use URL-safe values because this password is embedded in the internal DSN.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
MASP_POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_DATABASE_PASSWORD
MASP_API_TOKEN=CHANGE_ME_STRONG_API_TOKEN

# Bootstrap admin account. Seeded on first start only; there is NO default
# password. Changing this later does NOT reset an existing admin — rotate the
# password from the admin UI. Login hints stay off in the pilot.
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
MASP_ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# Bind API to loopback when a reverse proxy runs on this host. For a remote
# load balancer, bind the MASP private IP and firewall it to the LB sources.
MASP_APP_BIND=127.0.0.1:8000

# ICAP is plain RFC 3507 TCP. Bind a private MASP interface for the storage client; never
# expose it to an untrusted network.
MASP_ICAP_BIND=127.0.0.1:1344
MASP_ICAP_SERVICE_NAME=masp
MASP_ICAP_ALLOWED_IPS=127.0.0.1
MASP_ICAP_WAIT_SECONDS=30
MASP_ICAP_PREVIEW_BYTES=0

# 50 MiB synchronous pilot limit. ICAP buffers complete request bodies, so do
# not remove this limit without a separate large-file design and benchmark.
MASP_UPLOAD_MAX_BYTES=52428800
MASP_ICAP_MAX_BYTES=52428800

# Persist samples on the host so the directory can later be shared with remote
# Defender/ESET workers. Use absolute Linux paths in the deployed environment.
MASP_STORAGE_DIR=/srv/masp/storage
MASP_RULES_DIR=./rules

MASP_API_MAX_WAIT_SECONDS=30
MASP_API_RETRY_AFTER_SECONDS=2
MASP_SCAN_PARTIAL_RESULTS_MAX_WAIT_SECONDS=120
MASP_WORKER_POLL_SECONDS=2
MASP_WORKER_TIMING_EVENTS_ENABLED=1
MASP_WORKER_ENGINE_KEYS=static_metadata,clamav,yara
MASP_ENGINE_JOB_LEASE_SECONDS=120

# Pool max is per process: app + worker + ICAP = at most 12 connections here.
MASP_DB_POOL_ENABLED=1
MASP_DB_POOL_MIN=0
MASP_DB_POOL_MAX=4
MASP_DB_POOL_TIMEOUT_SECONDS=30

MASP_CLAMD_TIMEOUT_SECONDS=180
MASP_CLAMD_READY_TIMEOUT_SECONDS=30
MASP_CLAMD_STREAM_MAX_LENGTH=64M
MASP_CLAMD_MAX_FILE_SIZE=64M
MASP_CLAMD_MAX_SCAN_SIZE=64M

MASP_LOG_MAX_SIZE=20m
MASP_LOG_MAX_FILES=5
